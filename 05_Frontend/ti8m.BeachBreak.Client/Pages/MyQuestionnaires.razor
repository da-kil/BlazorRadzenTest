@page "/my-questionnaires"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using Radzen
@using Radzen.Blazor
@using ti8m.BeachBreak.Client.Models
@using ti8m.BeachBreak.Client.Services
@using ti8m.BeachBreak.Client.Components.Shared
@using ti8m.BeachBreak.Client.Layout
@inherits BaseQuestionnaireListPage
@inject IEmployeeQuestionnaireService EmployeeQuestionnaireService
@inject IQuestionnaireTemplateService TemplateService
@inject IUITranslationService TranslationService
@inject IQuestionnaireAssignmentService AssignmentService

<PageTitle>@T("nav.my-questionnaires")</PageTitle>

<PageLayout Title="@T("nav.my-questionnaires")"
                   Description="@T("pages.my-questionnaires-description")">
	<HeaderActions>
		@if (configuration?.Actions != null)
		{
			@foreach (var action in configuration.Actions.Where(a => a.IsVisible))
			{
				<RadzenButton Text="@action.Text"
							 Icon="@action.Icon"
							 ButtonStyle="@GetButtonStyle(action.ButtonStyle)"
							 Click="@(async () => await HandleActionClick(action))"
							 Size="ButtonSize.Medium" />
			}
		}
	</HeaderActions>
	<ChildContent>
		<RadzenTabs @bind-SelectedIndex="@selectedTabIndex">
			<Tabs>
				<RadzenTabsItem Text="@T("tabs.myAssignments")">
					@if (configuration != null && dataService != null)
					{
						<GenericQuestionnaireListPage Configuration="@configuration"
													  DataService="@dataService"
													  OnStartQuestionnaire="@StartQuestionnaire"
													  HideHeader="true"
													  HideFilterBar="true" />
					}
					else if (isLoading)
					{
						<LoadingIndicator Message="@T("dashboard.loading-questionnaires")" />
					}
					else
					{
						<EmptyState Icon="quiz" Title="@T("dashboard.no-questionnaire-data")" />
					}
				</RadzenTabsItem>

				<RadzenTabsItem Text="@T("tabs.viewing")" BadgeTitle="@(viewerAssignments.Count(a => WorkflowStateHelper.CanViewerAccess(a)).ToString())" Visible="@(viewerAssignments.Any(a => WorkflowStateHelper.CanViewerAccess(a)))">
					@if (isLoading)
					{
						<LoadingIndicator Message="@T("dashboard.loading-questionnaires")" />
					}
					else
					{
						var accessibleViewerAssignments = viewerAssignments.Where(a => WorkflowStateHelper.CanViewerAccess(a)).ToList();
						@if (!accessibleViewerAssignments.Any())
						{
							<EmptyState Icon="visibility" Title="@T("assignments.viewers.noViewerAssignments")" />
						}
						else
						{
							@foreach (var assignment in accessibleViewerAssignments)
							{
								<div class="d-flex align-items-center justify-content-between py-3 border-bottom cursor-pointer"
									 @onclick="@(() => NavigationManager.NavigateTo($"/questionnaire/{assignment.Id}?viewer=true"))">
									<div>
										<div class="d-flex align-items-center gap-2">
											<RadzenText TextStyle="TextStyle.Body2" Class="fw-bold mb-0">@assignment.TemplateName</RadzenText>
											<RadzenBadge Text="@T("assignments.viewers.observerBadge")"
														 BadgeStyle="BadgeStyle.Info"
														 Style="font-size: 0.7rem;" />
										</div>
										<RadzenText TextStyle="TextStyle.Caption" Class="text-muted mb-0">@assignment.EmployeeName</RadzenText>
									</div>
									<RadzenBadge Text="@T(WorkflowStateHelper.GetStateDisplayName(assignment.WorkflowState))"
												 BadgeStyle="BadgeStyle.Light"
												 Style="@($"font-size: 0.75rem; background-color: {WorkflowStateHelper.GetStateColor(assignment.WorkflowState)}; color: white;")" />
								</div>
							}
						}
					}
				</RadzenTabsItem>
			</Tabs>
		</RadzenTabs>
	</ChildContent>
</PageLayout>

@code {
	protected override string[] GetRequiredTranslationCategories()
	{
		return new[]
		{
			TranslationCategories.Navigation,
			TranslationCategories.Pages,
			TranslationCategories.Dashboard,
			TranslationCategories.Messages,
			TranslationCategories.Assignments,
			TranslationCategories.WorkflowStates,
			TranslationCategories.Tabs
		};
	}

	// Employee-specific state
	private List<QuestionnaireAssignment> allAssignments = new();
	private List<QuestionnaireAssignment> newQuestionnaires = new();
	private List<QuestionnaireAssignment> inProgressQuestionnaires = new();
	private List<QuestionnaireAssignment> completedQuestionnaires = new();
	private List<QuestionnaireAssignment> overdueQuestionnaires = new();
	private List<QuestionnaireAssignment> viewerAssignments = new();
	private int selectedTabIndex = 0;
	private bool hasInitialized = false;

	protected override string GetInitializationContext() => "InitializeMyQuestionnaires";

	protected override async Task OnParametersSetAsync()
	{
		// Skip refresh on initial load (OnInitializedAsync handles that)
		if (!hasInitialized)
		{
			hasInitialized = true;
			return;
		}

		// This runs every time the user navigates back to this page after initial load
		// Reload data to ensure we have the latest assignment statuses
		await RefreshData();
	}

	protected override async Task LoadRoleSpecificDataAsync()
	{
		// Create the data service
		dataService = new EmployeeQuestionnaireDataService(EmployeeQuestionnaireService, TemplateService);

		// Load assignments and viewer assignments in parallel
		var assignmentsTask = EmployeeQuestionnaireService.GetMyAssignmentsAsync();
		var viewerAssignmentsTask = AssignmentService.GetAssignmentsAsViewerAsync();

		await Task.WhenAll(assignmentsTask, viewerAssignmentsTask);

		allAssignments = await assignmentsTask;
		viewerAssignments = await viewerAssignmentsTask;

		// Categorize assignments
		CategorizeQuestionnaires();
	}

	protected override async Task<QuestionnairePageConfiguration> CreateConfigurationAsync()
	{
		return await QuestionnairePageConfigurationFactory.CreateEmployeeConfigurationAsync(
			allAssignments,
			newQuestionnaires,
			inProgressQuestionnaires,
			completedQuestionnaires,
			overdueQuestionnaires,
			categories,
			TranslationService,
			CurrentLanguage);
	}

	protected override void ConfigureActions()
	{
		if (configuration?.Actions != null)
		{
			foreach (var action in configuration.Actions)
			{
				if (action.Id == "start-questionnaire")
				{
					action.OnClick = () => StartSelectedQuestionnaire();
				}
			}
		}
	}

	protected override bool HasAdditionalStateChanged()
	{
		return StateService.HasParameterChanged(nameof(allAssignments), allAssignments.Count);
	}

	private void CategorizeQuestionnaires()
	{
		var now = DateTime.Now;

		// Upcoming: Empty list - once assigned, treat as in-progress for better UX
		// Even if no sections are completed yet, having ANY saved responses means work has started
		newQuestionnaires = new List<QuestionnaireAssignment>();

		// Current: Employee is working, submitted, or in review process
		// Excludes Assigned state (manager-only initialization phase)
		// Includes Initialized state and onwards (employee can see and start working)
		// Includes all states where employee might still need to take action or is waiting
		inProgressQuestionnaires = allAssignments.Where(a =>
			a.WorkflowState is WorkflowState.Initialized
			or WorkflowState.EmployeeInProgress
			or WorkflowState.ManagerInProgress
			or WorkflowState.BothInProgress
			or WorkflowState.EmployeeSubmitted
			or WorkflowState.ManagerSubmitted
			or WorkflowState.BothSubmitted
			or WorkflowState.InReview
			or WorkflowState.EmployeeReviewConfirmed
			or WorkflowState.ReviewFinished).ToList();

		// Completed: ONLY finalized questionnaires
		completedQuestionnaires = allAssignments.Where(a =>
			a.WorkflowState == WorkflowState.Finalized).ToList();

		// Overdue: Any non-completed assignment past due date
		overdueQuestionnaires = allAssignments.Where(a =>
			a.DueDate.HasValue &&
			a.DueDate.Value < now &&
			a.WorkflowState != WorkflowState.Finalized).ToList();

	}

	private async Task StartSelectedQuestionnaire()
	{
		ShowInfo("Select a questionnaire from the list to start working on it.");
	}

	private async Task StartQuestionnaire(QuestionnaireAssignment assignment)
	{
		if (assignment == null) return;

		try
		{
			// Navigate to the unified questionnaire page
			NavigationManager.NavigateTo($"/questionnaire/{assignment.Id}");
		}
		catch (Exception ex)
		{
			HandleError(ex, "starting questionnaire");
		}
	}


}
