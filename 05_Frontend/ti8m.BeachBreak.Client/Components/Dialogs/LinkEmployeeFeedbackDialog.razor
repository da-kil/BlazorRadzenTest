@using Radzen
@using Radzen.Blazor
@using ti8m.BeachBreak.Client.Models
@using ti8m.BeachBreak.Client.Models.Dto
@using ti8m.BeachBreak.Client.Services
@using ti8m.BeachBreak.Client.Components.Shared
@inject DialogService DialogService
@inject IEmployeeFeedbackApiService FeedbackApiService
@inherits CategoryOptimizedTranslatableComponent

<div class="link-feedback-dialog">
    @if (isLoading)
    {
        <LoadingIndicator Message="@T("messages.loading-available-feedback")" Size="ProgressBarCircularSize.Medium" Padding="2rem" />
    }
    else if (availableFeedback == null || availableFeedback.Count == 0)
    {
        <EmptyState Icon="feedback" Title="@T("messages.no-feedback-available")" Compact="true" />
    }
    else
    {
        <div class="feedback-list-header">
            <div class="feedback-select-all">
                <RadzenCheckBox TriState="false"
                               TValue="bool"
                               Value="@(selectedFeedback.Count > 0 && selectedFeedback.Count == filteredFeedback.Count)"
                               Change="@((args) => ToggleSelectAll(args))" />
                <span class="select-all-label">@T("labels.select-all")</span>
            </div>
            <div class="feedback-header-right">
                <RadzenDropDown TValue="int?"
                               Data="@availableYears"
                               Value="@selectedYear"
                               ValueChanged="@((int? y) => OnYearChanged(y))"
                               Placeholder="@T("labels.all-years")"
                               AllowClear="true"
                               Style="width: 110px" />
                <span class="feedback-count">
                    @if (selectedFeedback.Count > 0)
                    {
                        @string.Format(T("labels.n-selected"), selectedFeedback.Count)
                    }
                    else
                    {
                        @string.Format(T("labels.n-available"), filteredFeedback.Count)
                    }
                </span>
            </div>
        </div>

        <div class="feedback-card-list">
            @foreach (var feedback in filteredFeedback)
            {
                var isSelected = selectedFeedback?.Contains(feedback) == true;
                <div class="feedback-card @(isSelected ? "selected" : "")" @onclick="() => ToggleFeedbackSelection(feedback)">
                    <div class="feedback-card-check">
                        <RadzenCheckBox TriState="false"
                                       TValue="bool"
                                       Value="@isSelected"
                                       Change="@((v) => ToggleFeedbackSelection(feedback))"
                                       @onclick:stopPropagation="true" />
                    </div>
                    <div class="feedback-card-body">
                        <div class="feedback-card-top">
                            <RadzenBadge BadgeStyle="@GetSourceTypeBadgeStyle(feedback.SourceType)"
                                        Text="@GetSourceTypeDisplayName(feedback.SourceType)"
                                        Class="source-badge" />
                            <span class="feedback-date">@feedback.FeedbackDate.ToShortDateString()</span>
                        </div>
                        <div class="feedback-card-main">
                            <span class="feedback-provider">@feedback.ProviderName</span>
                            @if (!string.IsNullOrEmpty(feedback.ProjectName))
                            {
                                <span class="feedback-project">@feedback.ProjectName</span>
                            }
                        </div>
                    </div>
                    <div class="feedback-card-rating">
                        @if (feedback.AverageRating.HasValue)
                        {
                            <RadzenRating ReadOnly="true" Value="@((int)Math.Round(feedback.AverageRating.Value))" Stars="5" />
                        }
                        else
                        {
                            <span class="no-rating">@T("labels.no-ratings")</span>
                        }
                    </div>
                </div>
            }
        </div>
    }

    <div class="dialog-actions-inline">
        <RadzenButton Text="@T("buttons.cancel")"
                    ButtonStyle="ButtonStyle.Light"
                    Click="@Cancel"
                    Disabled="@isSubmitting" />
        <RadzenButton Text="@(isSubmitting ? T("buttons.linking") : T("buttons.link-selected"))"
                    Icon="@(isSubmitting ? "" : "link")"
                    ButtonStyle="ButtonStyle.Primary"
                    Click="@LinkSelected"
                    Disabled="@(isSubmitting || selectedFeedback == null || selectedFeedback.Count == 0)" />
    </div>
</div>

@code {
    [Parameter] public Guid AssignmentId { get; set; }
    [Parameter] public Guid QuestionId { get; set; }

    protected override string[] GetRequiredTranslationCategories()
    {
        return new[]
        {
            TranslationCategories.Dialogs,
            TranslationCategories.Buttons,
            TranslationCategories.Messages,
            TranslationCategories.Sections,
            TranslationCategories.Labels,
            TranslationCategories.Columns,
            TranslationCategories.Notifications
        };
    }

    private bool isLoading = true;
    private bool isSubmitting = false;
    private List<LinkedEmployeeFeedbackDto>? availableFeedback;
    private List<LinkedEmployeeFeedbackDto> selectedFeedback = new();
    private int? selectedYear;

    private List<int> availableYears =>
        availableFeedback?
            .Select(f => f.FeedbackDate.Year)
            .Distinct()
            .OrderByDescending(y => y)
            .ToList() ?? new();

    private List<LinkedEmployeeFeedbackDto> filteredFeedback =>
        availableFeedback?
            .Where(f => selectedYear == null || f.FeedbackDate.Year == selectedYear)
            .ToList() ?? new();

    protected override async Task OnInitializedAsync()
    {
        await LoadAvailableFeedback();
    }

    private async Task LoadAvailableFeedback()
    {
        isLoading = true;
        try
        {
            availableFeedback = await FeedbackApiService.GetAvailableFeedbackForAssignmentAsync(AssignmentId);
        }
        catch (Exception ex)
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = T("notifications.error"),
                Detail = $"Error loading feedback: {ex.Message}",
                Duration = 4000
            });
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OnYearChanged(int? year)
    {
        selectedYear = year;
        // Drop selections that are no longer visible
        selectedFeedback = selectedFeedback.Intersect(filteredFeedback).ToList();
    }

    private void ToggleSelectAll(bool? selectAll)
    {
        selectedFeedback = selectAll == true ? filteredFeedback.ToList() : new();
    }

    private void ToggleFeedbackSelection(LinkedEmployeeFeedbackDto feedback)
    {
        if (selectedFeedback.Contains(feedback))
            selectedFeedback.Remove(feedback);
        else
            selectedFeedback.Add(feedback);
    }

    private async Task LinkSelected()
    {
        if (selectedFeedback == null || selectedFeedback.Count == 0)
            return;

        isSubmitting = true;

        var successCount = 0;
        var failureCount = 0;

        foreach (var feedback in selectedFeedback)
        {
            var dto = new LinkEmployeeFeedbackDto
            {
                QuestionId = QuestionId,
                FeedbackId = feedback.FeedbackId
            };

            var success = await FeedbackApiService.LinkFeedbackToAssignmentAsync(AssignmentId, dto);
            if (success)
                successCount++;
            else
                failureCount++;
        }

        isSubmitting = false;

        if (successCount > 0)
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Success,
                Summary = T("notifications.feedback-linked-title"),
                Detail = string.Format(T("notifications.feedback-linked-detail"), successCount),
                Duration = 4000
            });

            DialogService.Close(true);
        }

        if (failureCount > 0)
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = T("notifications.feedback-link-failed-title"),
                Detail = string.Format(T("notifications.feedback-link-failed-detail"), failureCount),
                Duration = 4000
            });
        }
    }

    private void Cancel()
    {
        DialogService.Close(false);
    }

    private BadgeStyle GetSourceTypeBadgeStyle(FeedbackSourceType sourceType) => sourceType switch
    {
        FeedbackSourceType.Customer => BadgeStyle.Success,
        FeedbackSourceType.Peer => BadgeStyle.Info,
        FeedbackSourceType.ProjectColleague => BadgeStyle.Warning,
        _ => BadgeStyle.Light
    };

    private string GetSourceTypeDisplayName(FeedbackSourceType sourceType) => sourceType switch
    {
        FeedbackSourceType.Customer => T("feedback-source.customer"),
        FeedbackSourceType.Peer => T("feedback-source.peer"),
        FeedbackSourceType.ProjectColleague => T("feedback-source.project-colleague"),
        _ => T("feedback-source.unknown")
    };
}
