@using Radzen
@using Radzen.Blazor
@using ti8m.BeachBreak.Client.Models
@using ti8m.BeachBreak.Client.Services
@using ti8m.BeachBreak.Client.Components.Shared
@inherits CategoryOptimizedTranslatableComponent
@inject IQuestionnaireAssignmentService AssignmentService
@inject DialogService DialogService

<div class="notes-list">
    @if (!Notes.Any() && !IsInlineMode)
    {
        <RadzenText TextStyle="TextStyle.Body2" Class="text-muted text-center p-3">
            @T("messages.no-notes-yet")
        </RadzenText>
    }
    else
    {
        @foreach (var note in Notes.OrderByDescending(n => n.Timestamp))
        {
            <div class="rc-entry mb-3">
                <div class="rc-meta">
                    @if (!IsInlineMode)
                    {
                        <span class="rc-label rc-label-info">@note.SectionTitle</span>
                    }
                    <span class="rc-author">
                        @if (!string.IsNullOrEmpty(note.AuthorName)) { @note.AuthorName <text> &middot; </text> }
                        @note.Timestamp.ToLocalTime().ToString("MMM dd, HH:mm")
                    </span>
                    @if (!IsReadOnly && editingNoteId != note.Id)
                    {
                        <span class="rc-actions">
                            <RadzenButton Icon="edit"
                                        ButtonStyle="ButtonStyle.Light"
                                        Size="ButtonSize.ExtraSmall"
                                        Click="@(() => StartEditNote(note))"
                                        title="@T("buttons.edit-note")" />
                            <RadzenButton Icon="delete"
                                        ButtonStyle="ButtonStyle.Danger"
                                        Size="ButtonSize.ExtraSmall"
                                        Click="@(() => DeleteNote(note))"
                                        title="@T("buttons.delete-note")" />
                        </span>
                    }
                </div>
                <div class="rc-body">
                    @if (editingNoteId == note.Id)
                    {
                        <RadzenTextArea @bind-Value="@editingContent"
                                        Rows="3"
                                        MaxLength="2000"
                                        Style="width: 100%; resize: vertical;" />
                        <RadzenStack Orientation="Orientation.Horizontal"
                                     JustifyContent="JustifyContent.SpaceBetween"
                                     AlignItems="AlignItems.Center"
                                     Class="mt-1">
                            <RadzenText TextStyle="TextStyle.Caption" Class="text-muted">
                                @(editingContent?.Length ?? 0) / 2000 @T("forms.characters")
                            </RadzenText>
                            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                                <RadzenButton Text="@T("buttons.cancel")"
                                              ButtonStyle="ButtonStyle.Light"
                                              Size="ButtonSize.Small"
                                              Click="@CancelEdit" />
                                <RadzenButton Text="@T("buttons.save")"
                                              ButtonStyle="ButtonStyle.Primary"
                                              Size="ButtonSize.Small"
                                              Click="@(() => SaveEdit(note))"
                                              Disabled="@(string.IsNullOrWhiteSpace(editingContent) || isSaving)" />
                            </RadzenStack>
                        </RadzenStack>
                    }
                    else
                    {
                        <span style="white-space: pre-wrap;">@note.Content</span>
                    }
                </div>
            </div>
        }
    }
</div>

@code {
    protected override string[] GetRequiredTranslationCategories()
    {
        return new[]
        {
            TranslationCategories.Messages,
            TranslationCategories.Buttons,
            TranslationCategories.Dialogs,
            TranslationCategories.Sections,
            TranslationCategories.Forms
        };
    }

    [Parameter, EditorRequired] public List<InReviewNote> Notes { get; set; } = new();
    [Parameter, EditorRequired] public Guid AssignmentId { get; set; }
    [Parameter] public EventCallback<InReviewNote> OnNoteUpdated { get; set; }
    [Parameter] public EventCallback<Guid> OnNoteDeleted { get; set; }
    [Parameter] public Models.QuestionSection? CurrentSection { get; set; }
    [Parameter] public bool IsReadOnly { get; set; } = false;
    [Parameter] public bool IsInlineMode { get; set; } = false;

    private Guid? editingNoteId;
    private string editingContent = string.Empty;
    private bool isSaving = false;

    private void StartEditNote(InReviewNote note)
    {
        editingNoteId = note.Id;
        editingContent = note.Content;
    }

    private void CancelEdit()
    {
        editingNoteId = null;
        editingContent = string.Empty;
    }

    private async Task SaveEdit(InReviewNote note)
    {
        var trimmed = editingContent.Trim();
        if (string.IsNullOrWhiteSpace(trimmed))
        {
            CancelEdit();
            return;
        }

        if (trimmed == note.Content)
        {
            CancelEdit();
            return;
        }

        isSaving = true;
        StateHasChanged();

        var success = await AssignmentService.UpdateInReviewNoteAsync(
            AssignmentId,
            note.Id,
            trimmed);

        isSaving = false;

        if (success)
        {
            var updatedNote = new InReviewNote
            {
                Id = note.Id,
                Content = trimmed,
                Timestamp = DateTime.Now,
                SectionId = note.SectionId,
                SectionTitle = note.SectionTitle,
                AuthorEmployeeId = note.AuthorEmployeeId,
                AuthorName = note.AuthorName
            };

            editingNoteId = null;
            editingContent = string.Empty;

            NotificationService.Notify(NotificationSeverity.Success,
                T("messages.note-updated"),
                T("messages.note-updated-successfully"));

            if (OnNoteUpdated.HasDelegate)
                await OnNoteUpdated.InvokeAsync(updatedNote);
        }
        else
        {
            NotificationService.Notify(NotificationSeverity.Error,
                T("messages.error"),
                T("messages.failed-to-update-note"));
        }
    }

    private async Task DeleteNote(InReviewNote note)
    {
        var confirmed = await DialogService.Confirm(
            T("messages.confirm-delete-note"),
            T("dialogs.delete-note"),
            new ConfirmOptions
            {
                OkButtonText = T("buttons.delete"),
                CancelButtonText = T("buttons.cancel")
            });

        if (confirmed == true)
        {
            var success = await AssignmentService.DeleteInReviewNoteAsync(
                AssignmentId,
                note.Id);

            if (success)
            {
                NotificationService.Notify(NotificationSeverity.Success,
                    T("messages.note-deleted"),
                    T("messages.note-deleted-successfully"));

                if (OnNoteDeleted.HasDelegate)
                    await OnNoteDeleted.InvokeAsync(note.Id);
            }
            else
            {
                NotificationService.Notify(NotificationSeverity.Error,
                    T("messages.error"),
                    T("messages.failed-to-delete-note"));
            }
        }
    }
}
