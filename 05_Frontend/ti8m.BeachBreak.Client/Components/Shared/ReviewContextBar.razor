@using ti8m.BeachBreak.Client.Services
@inherits CategoryOptimizedTranslatableComponent

<div class="review-context-bar">
    <div class="review-avatar" title="@EmployeeName">@Initials</div>
    <span class="review-employee-label">@T("labels.reviewing-employee"):</span>
    <span class="review-employee-name">@EmployeeName</span>
    <div class="review-divider"></div>
    <span class="review-questionnaire-name" title="@QuestionnaireName">@QuestionnaireName</span>
    <span class="review-mode-badge">@T("labels.review-mode-badge")</span>
</div>

@code {
    [Parameter, EditorRequired] public string EmployeeName { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string QuestionnaireName { get; set; } = string.Empty;

    private string Initials => ComputeInitials(EmployeeName);

    protected override string[] GetRequiredTranslationCategories() =>
        new[] { TranslationCategories.Labels };

    private static string ComputeInitials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length >= 2
            ? $"{parts[0][0]}{parts[^1][0]}".ToUpperInvariant()
            : parts[0][0].ToString().ToUpperInvariant();
    }
}
