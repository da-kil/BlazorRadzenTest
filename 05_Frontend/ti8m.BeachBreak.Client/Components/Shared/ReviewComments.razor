@using ti8m.BeachBreak.Client.Models
@using Radzen
@using Radzen.Blazor
@inherits CategoryOptimizedTranslatableComponent

@if (ShouldShowComments())
{
    <div class="review-comments-section mb-4">
        <div class="rc-title mb-3">
            <RadzenIcon Icon="comment" Class="me-1" />
            <span>@T("sections.review-comments")</span>
        </div>

        @if (ShouldShowEmployeeComments())
        {
            <div class="rc-entry employee-entry mb-3">
                <div class="rc-meta">
                    <span class="rc-label rc-label-success">@T("sections.employee-comments")</span>
                    <span class="rc-author">@Assignment?.EmployeeName &middot; @T("labels.when-confirming-review-outcome")</span>
                    @if (Assignment?.EmployeeReviewConfirmedDate.HasValue == true)
                    {
                        <span class="rc-date">@Assignment.EmployeeReviewConfirmedDate.Value.ToLocalTime().ToString("MMM dd, yyyy HH:mm")</span>
                    }
                </div>
                <div class="rc-body rc-body-success">
                    @if (!string.IsNullOrWhiteSpace(Assignment?.EmployeeReviewComments))
                    {
                        <span style="white-space: pre-wrap;">@Assignment.EmployeeReviewComments</span>
                    }
                    else
                    {
                        <span class="rc-empty">@T("messages.no-comments-provided")</span>
                    }
                </div>
            </div>
        }

        @if (ShouldShowManagerFinalNotes())
        {
            <div class="rc-entry final-entry mb-3">
                <div class="rc-meta">
                    <span class="rc-label rc-label-warning">@T("sections.manager-final-notes")</span>
                    <span class="rc-author">@(Assignment?.FinalizedByEmployeeName ?? T("labels.manager")) &middot; @T("labels.when-finalizing-internal")</span>
                    @if (Assignment?.FinalizedDate.HasValue == true)
                    {
                        <span class="rc-date">@Assignment.FinalizedDate.Value.ToLocalTime().ToString("MMM dd, yyyy HH:mm")</span>
                    }
                </div>
                <div class="rc-body rc-body-warning">
                    @if (!string.IsNullOrWhiteSpace(Assignment?.ManagerFinalNotes))
                    {
                        <span style="white-space: pre-wrap;">@Assignment.ManagerFinalNotes</span>
                    }
                    else
                    {
                        <span class="rc-empty">@T("messages.no-final-notes-provided")</span>
                    }
                </div>
            </div>
        }
    </div>
}


@code {
    protected override string[] GetRequiredTranslationCategories() =>
    [
        TranslationCategories.Sections,
        TranslationCategories.Labels,
        TranslationCategories.Messages
    ];

    [Parameter]
    public QuestionnaireAssignment? Assignment { get; set; }

    [Parameter]
    public bool IsEmployee { get; set; }

    [Parameter]
    public bool IsManager { get; set; }

    private bool ShouldShowComments()
    {
        if (Assignment == null) return false;

        return Assignment.WorkflowState is
            WorkflowState.ReviewFinished or
            WorkflowState.EmployeeReviewConfirmed or
            WorkflowState.Finalized;
    }

    private bool ShouldShowEmployeeComments()
    {
        if (Assignment == null) return false;

        return Assignment.WorkflowState is
            WorkflowState.EmployeeReviewConfirmed or
            WorkflowState.Finalized;
    }

    private bool ShouldShowManagerFinalNotes()
    {
        if (Assignment == null) return false;

        if (IsEmployee && !IsManager)
            return false;

        return IsManager && Assignment.WorkflowState == WorkflowState.Finalized;
    }
}
