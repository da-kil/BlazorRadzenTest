@using Radzen.Blazor
@using ti8m.BeachBreak.Client.Models
@using ti8m.BeachBreak.Client.Components.Shared
@using ti8m.BeachBreak.Client.Components.QuestionnaireBuilder
@inherits CompositionComponentBase

@if (questions.Count == 0)
{
    <div class="empty-state">
        <RadzenIcon Icon="check_box" Class="empty-state-icon" />
        <div class="empty-state-text">No questions configured. Click "Add Item" to add a question.</div>
    </div>
}
else
{
    <div class="mc-questions">
        @for (int qi = 0; qi < questions.Count; qi++)
        {
            var questionIndex = qi;
            var question = questions[questionIndex];
            var choiceList = question.Choices.OrderBy(c => c.Order).ToList();

            <div class="mc-question-block">
                <!-- Question title/description -->
                <UnifiedItemCard
                    ItemTitle="@($"Question {questionIndex + 1}")"
                    IsRequired="@question.IsRequired"
                    CheckboxId="@($"mc_req_{Section.Id}_{questionIndex}")"
                    OnRequiredChanged="@((bool v) => { question.MinSelections = v ? Math.Max(1, question.MinSelections) : 0; NotifyChanged(); })"
                    OnMoveUp="@(() => MoveQuestionUp(questionIndex))"
                    OnMoveDown="@(() => MoveQuestionDown(questionIndex))"
                    OnDelete="@(() => RemoveQuestion(questionIndex))"
                    MoveUpDisabled="@(questionIndex == 0)"
                    MoveDownDisabled="@(questionIndex == questions.Count - 1)"
                    TitleEnglishLabel="English Title"
                    TitleGermanLabel="German Title"
                    TitleEnglish="@question.TitleEnglish"
                    TitleGerman="@question.TitleGerman"
                    TitleEnglishPlaceholder="Enter question text..."
                    TitleGermanPlaceholder="German question text..."
                    OnTitleEnglishChanged="@((string v) => { question.TitleEnglish = v ?? ""; NotifyChanged(); })"
                    OnTitleGermanChanged="@((string v) => { question.TitleGerman = v ?? ""; NotifyChanged(); })"
                    DescriptionEnglish="@(question.DescriptionEnglish ?? "")"
                    DescriptionGerman="@(question.DescriptionGerman ?? "")"
                    DescriptionEnglishPlaceholder="Optional description..."
                    DescriptionGermanPlaceholder="Optional German description..."
                    OnDescriptionEnglishChanged="@((string v) => { question.DescriptionEnglish = v; NotifyChanged(); })"
                    OnDescriptionGermanChanged="@((string v) => { question.DescriptionGerman = v; NotifyChanged(); })"
                    Disabled="@(!Template.IsAvailableForEditing)" />

                <!-- Choices for this question -->
                <div class="mc-choices">
                    @if (choiceList.Count == 0)
                    {
                        <div class="choices-empty">No choices yet. Add at least one choice below.</div>
                    }
                    else
                    {
                        @for (int ci = 0; ci < choiceList.Count; ci++)
                        {
                            var choiceIndex = ci;
                            var choice = choiceList[choiceIndex];

                            <UnifiedItemCard
                                ItemTitle="@($"Choice {choiceIndex + 1}")"
                                IsRequired="false"
                                ShowRequiredCheckbox="false"
                                OnMoveUp="@(() => MoveChoiceUp(questionIndex, choiceIndex))"
                                OnMoveDown="@(() => MoveChoiceDown(questionIndex, choiceIndex))"
                                OnDelete="@(() => RemoveChoice(questionIndex, choiceIndex))"
                                MoveUpDisabled="@(choiceIndex == 0)"
                                MoveDownDisabled="@(choiceIndex == choiceList.Count - 1)"
                                TitleEnglishLabel="English Label"
                                TitleGermanLabel="German Label"
                                TitleEnglish="@choice.LabelEnglish"
                                TitleGerman="@choice.LabelGerman"
                                TitleEnglishPlaceholder="Enter choice label..."
                                TitleGermanPlaceholder="German label..."
                                OnTitleEnglishChanged="@((string v) => { choice.LabelEnglish = v ?? ""; NotifyChanged(); })"
                                OnTitleGermanChanged="@((string v) => { choice.LabelGerman = v ?? ""; NotifyChanged(); })"
                                DescriptionEnglish="@(choice.DescriptionEnglish ?? "")"
                                DescriptionGerman="@(choice.DescriptionGerman ?? "")"
                                DescriptionEnglishPlaceholder="Optional description..."
                                DescriptionGermanPlaceholder="Optional German description..."
                                OnDescriptionEnglishChanged="@((string v) => { choice.DescriptionEnglish = v; NotifyChanged(); })"
                                OnDescriptionGermanChanged="@((string v) => { choice.DescriptionGerman = v; NotifyChanged(); })"
                                Disabled="@(!Template.IsAvailableForEditing)" />
                        }
                    }

                    <div class="add-choice-row">
                        <RadzenButton Text="Add Choice"
                                      Icon="add"
                                      ButtonStyle="ButtonStyle.Light"
                                      Size="ButtonSize.Small"
                                      Click="@(() => AddChoice(questionIndex))"
                                      Disabled="@(!Template.IsAvailableForEditing)" />
                    </div>
                </div>

                <!-- Min/Max selections for this question -->
                <div class="selection-constraints">
                    <div class="constraint-row">
                        <label class="constraint-label">Min Selections</label>
                        <RadzenNumeric TValue="int"
                                       Value="@question.MinSelections"
                                       ValueChanged="@((int v) => { question.MinSelections = v; NotifyChanged(); })"
                                       Min="0"
                                       Max="@question.Choices.Count"
                                       Disabled="@(!Template.IsAvailableForEditing)"
                                       Class="constraint-input" />
                    </div>
                    <div class="constraint-row">
                        <label class="constraint-label">Max Selections</label>
                        <RadzenNumeric TValue="int"
                                       Value="@question.MaxSelections"
                                       ValueChanged="@((int v) => { question.MaxSelections = v; NotifyChanged(); })"
                                       Min="@question.MinSelections"
                                       Max="@question.Choices.Count"
                                       Disabled="@(!Template.IsAvailableForEditing)"
                                       Class="constraint-input" />
                    </div>
                    @if (question.MaxSelections < question.MinSelections)
                    {
                        <div class="constraint-error">Max selections must be >= min selections</div>
                    }
                    @if (question.Choices.Count > 0 && question.MaxSelections > question.Choices.Count)
                    {
                        <div class="constraint-error">Max selections cannot exceed number of choices (@question.Choices.Count)</div>
                    }
                    @if (question.MinSelections == 0)
                    {
                        <div class="constraint-hint">Min = 0: question is optional</div>
                    }
                </div>
            </div>
        }
    </div>
}

@code {
    [Parameter] public QuestionSection Section { get; set; } = new();
    [Parameter] public QuestionnaireTemplate Template { get; set; } = new();
    [Parameter] public EventCallback OnChanged { get; set; }

    private List<MultipleChoiceQuestion> questions = new();
    private MultipleChoiceConfiguration? config;

    protected override void OnParametersSet()
    {
        if (Section.Configuration is MultipleChoiceConfiguration mc)
        {
            config = mc;
            questions = mc.Questions.OrderBy(q => q.Order).ToList();
        }
        else
        {
            config = null;
            questions = new List<MultipleChoiceQuestion>();
        }
    }

    private void MoveQuestionUp(int index)
    {
        if (config == null || index <= 0 || index >= questions.Count) return;
        (questions[index], questions[index - 1]) = (questions[index - 1], questions[index]);
        for (int i = 0; i < questions.Count; i++) questions[i].Order = i;
        config.Questions = questions;
        NotifyChanged();
    }

    private void MoveQuestionDown(int index)
    {
        if (config == null || index < 0 || index >= questions.Count - 1) return;
        (questions[index], questions[index + 1]) = (questions[index + 1], questions[index]);
        for (int i = 0; i < questions.Count; i++) questions[i].Order = i;
        config.Questions = questions;
        NotifyChanged();
    }

    private void RemoveQuestion(int index)
    {
        if (config == null || index < 0 || index >= questions.Count) return;
        questions.RemoveAt(index);
        for (int i = 0; i < questions.Count; i++) questions[i].Order = i;
        config.Questions = questions;
        NotifyChanged();
    }

    private void AddChoice(int questionIndex)
    {
        if (questionIndex < 0 || questionIndex >= questions.Count) return;
        var q = questions[questionIndex];
        var nextOrder = q.Choices.Count > 0 ? q.Choices.Max(c => c.Order) + 1 : 0;
        q.Choices.Add(new ChoiceOption($"choice_{q.Choices.Count + 1}", "", "", nextOrder));
        NotifyChanged();
    }

    private void MoveChoiceUp(int questionIndex, int choiceIndex)
    {
        if (questionIndex < 0 || questionIndex >= questions.Count) return;
        var choices = questions[questionIndex].Choices.OrderBy(c => c.Order).ToList();
        if (choiceIndex <= 0 || choiceIndex >= choices.Count) return;
        (choices[choiceIndex], choices[choiceIndex - 1]) = (choices[choiceIndex - 1], choices[choiceIndex]);
        for (int i = 0; i < choices.Count; i++) choices[i].Order = i;
        questions[questionIndex].Choices = choices;
        NotifyChanged();
    }

    private void MoveChoiceDown(int questionIndex, int choiceIndex)
    {
        if (questionIndex < 0 || questionIndex >= questions.Count) return;
        var choices = questions[questionIndex].Choices.OrderBy(c => c.Order).ToList();
        if (choiceIndex < 0 || choiceIndex >= choices.Count - 1) return;
        (choices[choiceIndex], choices[choiceIndex + 1]) = (choices[choiceIndex + 1], choices[choiceIndex]);
        for (int i = 0; i < choices.Count; i++) choices[i].Order = i;
        questions[questionIndex].Choices = choices;
        NotifyChanged();
    }

    private void RemoveChoice(int questionIndex, int choiceIndex)
    {
        if (questionIndex < 0 || questionIndex >= questions.Count) return;
        var choices = questions[questionIndex].Choices.OrderBy(c => c.Order).ToList();
        if (choiceIndex < 0 || choiceIndex >= choices.Count) return;
        choices.RemoveAt(choiceIndex);
        for (int i = 0; i < choices.Count; i++) choices[i].Order = i;
        var q = questions[questionIndex];
        q.Choices = choices;
        if (q.MaxSelections > choices.Count) q.MaxSelections = Math.Max(q.MinSelections, choices.Count);
        NotifyChanged();
    }

    private void NotifyChanged()
    {
        StateHasChanged();
        _ = OnChanged.InvokeAsync();
    }
}

<style>
    .empty-state {
        text-align: center;
        padding: 2rem 1rem;
        color: var(--rz-text-muted);
    }

    .empty-state-icon {
        font-size: 3rem;
        opacity: 0.5;
        margin-bottom: 0.75rem;
    }

    .empty-state-text {
        font-size: 0.875rem;
    }

    .mc-questions {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    .mc-question-block {
    }

    .mc-choices {
        padding: 1rem 0;
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .choices-empty {
        font-size: 0.875rem;
        color: var(--rz-text-muted);
        text-align: center;
        padding: 0.5rem;
    }

    .add-choice-row {
        display: flex;
        justify-content: flex-start;
        padding-top: 0.25rem;
    }

    .selection-constraints {
        padding: 0.75rem 0 0 0;
        border-top: 1px solid var(--rz-border-color);
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .constraint-row {
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .constraint-label {
        font-size: 0.875rem;
        font-weight: var(--font-weight-emphasis);
        min-width: 120px;
        color: var(--rz-text-color);
    }

    .constraint-input {
        width: 80px;
    }

    .constraint-error {
        font-size: 0.8125rem;
        color: var(--rz-danger);
    }

    .constraint-hint {
        font-size: 0.8125rem;
        color: var(--rz-text-muted);
        font-style: italic;
    }
</style>
