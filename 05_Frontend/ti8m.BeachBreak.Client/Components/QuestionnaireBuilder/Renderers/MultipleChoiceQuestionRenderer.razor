@using Radzen.Blazor
@using ti8m.BeachBreak.Client.Models
@using ti8m.BeachBreak.Client.Components.Shared
@using ti8m.BeachBreak.Client.Components.QuestionnaireBuilder
@inherits CompositionComponentBase

@if (choices.Count == 0)
{
    <div class="empty-state">
        <RadzenIcon Icon="check_box" Class="empty-state-icon" />
        <div class="empty-state-text">No choices configured</div>
    </div>
}
else
{
    <div class="choice-items">
        @for (int i = 0; i < choices.Count; i++)
        {
            var choiceIndex = i;
            var choice = choices[choiceIndex];

            <UnifiedItemCard
                ItemTitle="@($"Choice {choiceIndex + 1}")"
                ShowRequiredCheckbox="false"

                OnMoveUp="@(() => OnMoveChoiceUp.InvokeAsync(choiceIndex))"
                OnMoveDown="@(() => OnMoveChoiceDown.InvokeAsync(choiceIndex))"
                OnDelete="@(() => OnRemoveChoice.InvokeAsync(choiceIndex))"
                MoveUpDisabled="@(choiceIndex == 0)"
                MoveDownDisabled="@(choiceIndex == choices.Count - 1)"

                TitleEnglishLabel="English Label"
                TitleGermanLabel="German Label"
                TitleEnglish="@choice.LabelEnglish"
                TitleGerman="@choice.LabelGerman"
                TitleEnglishPlaceholder="Enter choice label..."
                TitleGermanPlaceholder="German label..."
                OnTitleEnglishChanged="@((string value) => OnUpdateChoiceLabelEnglish.InvokeAsync((choiceIndex, value)))"
                OnTitleGermanChanged="@((string value) => OnUpdateChoiceLabelGerman.InvokeAsync((choiceIndex, value)))"

                DescriptionEnglish=""
                DescriptionGerman=""
                DescriptionEnglishPlaceholder=""
                DescriptionGermanPlaceholder=""

                Disabled="@(!Template.IsAvailableForEditing)" />
        }
    </div>
}

<div class="selection-constraints">
    <div class="constraint-row">
        <label class="constraint-label">Min Selections</label>
        <RadzenNumeric TValue="int"
                       Value="@minSelections"
                       ValueChanged="@((int v) => OnUpdateMinSelections.InvokeAsync(v))"
                       Min="0"
                       Max="@choices.Count"
                       Disabled="@(!Template.IsAvailableForEditing)"
                       Class="constraint-input" />
    </div>
    <div class="constraint-row">
        <label class="constraint-label">Max Selections</label>
        <RadzenNumeric TValue="int"
                       Value="@maxSelections"
                       ValueChanged="@((int v) => OnUpdateMaxSelections.InvokeAsync(v))"
                       Min="@minSelections"
                       Max="@choices.Count"
                       Disabled="@(!Template.IsAvailableForEditing)"
                       Class="constraint-input" />
    </div>
    @if (maxSelections < minSelections)
    {
        <div class="constraint-error">Max selections must be >= min selections</div>
    }
    @if (maxSelections > choices.Count && choices.Count > 0)
    {
        <div class="constraint-error">Max selections cannot exceed number of choices (@choices.Count)</div>
    }
    @if (minSelections == 0)
    {
        <div class="constraint-hint">Min = 0: question is optional (not required for completion)</div>
    }
</div>

@code {
    [Parameter] public QuestionSection Section { get; set; } = new();
    [Parameter] public QuestionnaireTemplate Template { get; set; } = new();

    [Parameter] public EventCallback<int> OnMoveChoiceUp { get; set; }
    [Parameter] public EventCallback<int> OnMoveChoiceDown { get; set; }
    [Parameter] public EventCallback<int> OnRemoveChoice { get; set; }
    [Parameter] public EventCallback<(int, string)> OnUpdateChoiceLabelEnglish { get; set; }
    [Parameter] public EventCallback<(int, string)> OnUpdateChoiceLabelGerman { get; set; }
    [Parameter] public EventCallback<int> OnUpdateMinSelections { get; set; }
    [Parameter] public EventCallback<int> OnUpdateMaxSelections { get; set; }

    private List<ChoiceOption> choices = new();
    private int minSelections = 1;
    private int maxSelections = 1;

    protected override void OnParametersSet()
    {
        if (Section.Configuration is MultipleChoiceConfiguration config)
        {
            choices = config.Choices.OrderBy(c => c.Order).ToList();
            minSelections = config.MinSelections;
            maxSelections = config.MaxSelections;
        }
        else
        {
            choices = new List<ChoiceOption>();
            minSelections = 1;
            maxSelections = 1;
        }
    }
}

<style>
    .empty-state {
        text-align: center;
        padding: 2rem 1rem;
        color: var(--rz-text-muted);
    }

    .empty-state-icon {
        font-size: 3rem;
        opacity: 0.5;
        margin-bottom: 0.75rem;
    }

    .empty-state-text {
        font-size: 0.875rem;
    }

    .choice-items {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        margin-bottom: 1.5rem;
    }

    .selection-constraints {
        padding: 1rem;
        background: var(--rz-base-100);
        border: 1px solid var(--rz-base-300);
        border-radius: 0.375rem;
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .constraint-row {
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .constraint-label {
        font-size: 0.875rem;
        font-weight: var(--font-weight-emphasis);
        min-width: 120px;
        color: var(--rz-text-color);
    }

    .constraint-input {
        width: 80px;
    }

    .constraint-error {
        font-size: 0.8125rem;
        color: var(--rz-danger);
    }

    .constraint-hint {
        font-size: 0.8125rem;
        color: var(--rz-text-muted);
        font-style: italic;
    }
</style>
