@using Radzen.Blazor
@using ti8m.BeachBreak.Client.Models
@using ti8m.BeachBreak.Client.Models.DTOs
@using ti8m.BeachBreak.Client.Components.Shared
@inherits CategoryOptimizedTranslatableComponent

@RenderQuestions()

@code {
    [Parameter, EditorRequired] public QuestionSection Section { get; set; } = default!;
    [Parameter, EditorRequired] public QuestionResponse Response { get; set; } = default!;
    [Parameter] public EventCallback<QuestionResponse> OnResponseChanged { get; set; }
    [Parameter] public bool IsReadOnly { get; set; } = false;

    protected override string[] GetRequiredTranslationCategories() =>
    [
        TranslationCategories.Questions,
        TranslationCategories.Labels,
        TranslationCategories.Messages
    ];

    private List<MultipleChoiceQuestion> questions = new();

    protected override async Task OnInitializedAsync()
    {
        LoadConfiguration();
        await base.OnInitializedAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (StateService.HasParameterChanged(nameof(Section), Section))
        {
            LoadConfiguration();
        }
        await base.OnParametersSetAsync();
    }

    private void LoadConfiguration()
    {
        if (Section.Configuration is MultipleChoiceConfiguration config && config.Questions.Any())
            questions = config.Questions.OrderBy(q => q.Order).ToList();
        else
            questions = new List<MultipleChoiceQuestion>();
    }

    protected override bool HasStateChanged()
    {
        var responseDataHash = Response.ResponseData?.GetHashCode() ?? 0;
        return StateService.HasParameterChanged(nameof(Response.ResponseData), responseDataHash) ||
               StateService.HasParameterChanged(nameof(questions), questions.Count);
    }

    private MultipleChoiceResponseDataDto GetOrCreateResponseData()
    {
        if (Response.ResponseData is not MultipleChoiceResponseDataDto data)
        {
            data = new MultipleChoiceResponseDataDto();
            Response.ResponseData = data;
        }
        return data;
    }

    private List<string> GetSelections(string questionKey)
    {
        var data = GetOrCreateResponseData();
        return data.SelectionsByQuestion.TryGetValue(questionKey, out var sel) ? sel : new List<string>();
    }

    private bool IsChoiceSelected(string questionKey, string choiceKey) =>
        GetSelections(questionKey).Contains(choiceKey);

    private bool IsCheckboxDisabled(string questionKey, string choiceKey, int maxSelections)
    {
        if (IsReadOnly) return true;
        var sel = GetSelections(questionKey);
        return !sel.Contains(choiceKey) && sel.Count >= maxSelections;
    }

    private async Task OnChoiceChanged(string questionKey, string choiceKey, bool isChecked, int maxSelections)
    {
        if (IsReadOnly) return;

        var data = GetOrCreateResponseData();
        if (!data.SelectionsByQuestion.ContainsKey(questionKey))
            data.SelectionsByQuestion[questionKey] = new List<string>();

        var list = data.SelectionsByQuestion[questionKey];
        if (isChecked)
        {
            if (!list.Contains(choiceKey) && list.Count < maxSelections)
                list.Add(choiceKey);
        }
        else
        {
            list.Remove(choiceKey);
        }

        Response.LastModified = DateTime.Now;

        if (OnResponseChanged.HasDelegate)
            await OnResponseChanged.InvokeAsync(Response);
    }

    private string GetLocalizedLabel(string english, string german, string fallback)
    {
        var lang = CurrentLanguage == Language.German ? "de" : "en";
        if (lang == "de" && !string.IsNullOrWhiteSpace(german)) return german;
        if (!string.IsNullOrWhiteSpace(english)) return english;
        return fallback;
    }

    private RenderFragment RenderQuestions() => __builder =>
    {
        if (!questions.Any())
        {
            <RadzenAlert AlertStyle="AlertStyle.Warning" Variant="Variant.Flat" Class="mb-3">
                <RadzenText TextStyle="TextStyle.Body2">
                    <strong>Configuration Error:</strong> No questions are defined for this section.
                </RadzenText>
            </RadzenAlert>
            return;
        }

        <div class="mc-questions">
            @foreach (var question in questions)
            {
                var qKey = question.Key;
                var qTitle = GetLocalizedLabel(question.TitleEnglish, question.TitleGerman, string.Empty);
                var selections = GetSelections(qKey);
                var selectionCount = selections.Count;
                var choices = question.Choices.OrderBy(c => c.Order).ToList();

                <div class="mc-question-block" @key="@qKey">
                    @if (!string.IsNullOrWhiteSpace(qTitle))
                    {
                        <div class="question-item-title">@qTitle</div>
                    }
                    @{
                        var qDesc = question.GetLocalizedDescription(CurrentLanguage == Language.German ? "de" : "en");
                    }
                    @if (!string.IsNullOrWhiteSpace(qDesc))
                    {
                        <div class="question-item-description">@qDesc</div>
                    }

                    <div class="choice-list">
                        @if (!choices.Any())
                        {
                            <RadzenAlert AlertStyle="AlertStyle.Warning" Variant="Variant.Flat" Class="mb-2">
                                <RadzenText TextStyle="TextStyle.Body2">No choices defined.</RadzenText>
                            </RadzenAlert>
                        }
                        else
                        {
                            @foreach (var choice in choices)
                            {
                                var choiceKey = choice.Key;
                                var lang = CurrentLanguage == Language.German ? "de" : "en";
                                var choiceLabel = choice.GetLocalizedLabelWithFallback(lang);
                                var choiceDesc = choice.GetLocalizedDescription(lang);
                                var isSelected = selections.Contains(choiceKey);
                                var isDisabled = IsCheckboxDisabled(qKey, choiceKey, question.MaxSelections);
                                var hasDesc = !string.IsNullOrWhiteSpace(choiceDesc);

                                <div class="choice-item @(isSelected ? "choice-selected" : "") @(isDisabled ? "choice-disabled" : "") @(hasDesc ? "choice-item-with-desc" : "")"
                                     @key="@choiceKey"
                                     @onclick="@(async () => { if (!IsReadOnly && !isDisabled) await OnChoiceChanged(qKey, choiceKey, !isSelected, question.MaxSelections); })">
                                    <span @onclick:stopPropagation="true">
                                        <RadzenCheckBox TValue="bool"
                                                       Value="@isSelected"
                                                       ValueChanged="@((bool v) => OnChoiceChanged(qKey, choiceKey, v, question.MaxSelections))"
                                                       Name="@($"choice_{Section.Id}_{qKey}_{choiceKey}")"
                                                       Disabled="@isDisabled" />
                                    </span>
                                    <div class="choice-content">
                                        <span @onclick:stopPropagation="true">
                                            <RadzenLabel Text="@choiceLabel"
                                                        Component="@($"choice_{Section.Id}_{qKey}_{choiceKey}")"
                                                        Class="choice-label" />
                                        </span>
                                        @if (hasDesc)
                                        {
                                            <div class="choice-description">@choiceDesc</div>
                                        }
                                    </div>
                                </div>
                            }

                            @if (question.MinSelections > 0)
                            {
                                <div class="selection-hint @(selectionCount < question.MinSelections ? "hint-error" : "hint-ok")">
                                    @if (selectionCount < question.MinSelections)
                                    {
                                        <RadzenIcon Icon="info" Class="me-1" />
                                        <span>Please select at least @question.MinSelections option@(question.MinSelections > 1 ? "s" : "") (@selectionCount / @question.MaxSelections selected)</span>
                                    }
                                    else
                                    {
                                        <RadzenIcon Icon="check_circle" Class="me-1" />
                                        <span>@selectionCount / @question.MaxSelections selected</span>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="selection-hint hint-optional">
                                    <RadzenIcon Icon="info" Class="me-1" />
                                    <span>Optional — select up to @question.MaxSelections option@(question.MaxSelections > 1 ? "s" : "") (@selectionCount selected)</span>
                                </div>
                            }
                        }
                    </div>
                </div>
            }
        </div>
    };
}
