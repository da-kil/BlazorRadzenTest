@using Radzen.Blazor
@using ti8m.BeachBreak.Client.Models
@using ti8m.BeachBreak.Client.Models.DTOs
@using ti8m.BeachBreak.Client.Components.Shared
@inherits CategoryOptimizedTranslatableComponent

@RenderItems()

@code {
    [Parameter, EditorRequired] public QuestionSection Section { get; set; } = default!;
    [Parameter, EditorRequired] public QuestionResponse Response { get; set; } = default!;
    [Parameter] public EventCallback<QuestionResponse> OnResponseChanged { get; set; }
    [Parameter] public bool IsReadOnly { get; set; } = false;

    protected override string[] GetRequiredTranslationCategories() =>
    [
        TranslationCategories.Questions,
        TranslationCategories.Labels,
        TranslationCategories.Messages
    ];

    private List<BinaryItem> items = new();

    protected override async Task OnInitializedAsync()
    {
        LoadConfiguration();
        await base.OnInitializedAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (StateService.HasParameterChanged(nameof(Section), Section))
        {
            LoadConfiguration();
        }
        await base.OnParametersSetAsync();
    }

    private void LoadConfiguration()
    {
        if (Section.Configuration is BinaryConfiguration config && config.Items.Count > 0)
            items = config.Items.OrderBy(i => i.Order).ToList();
        else
            items = new List<BinaryItem>();
    }

    protected override bool HasStateChanged()
    {
        var responseDataHash = Response.ResponseData?.GetHashCode() ?? 0;
        return StateService.HasParameterChanged(nameof(Response.ResponseData), responseDataHash);
    }

    private BinaryResponseDataDto GetOrCreateResponseData()
    {
        if (Response.ResponseData is not BinaryResponseDataDto data)
        {
            data = new BinaryResponseDataDto();
            Response.ResponseData = data;
        }
        return data;
    }

    private string? GetSelectedOption(string itemKey) =>
        GetOrCreateResponseData().Selections.TryGetValue(itemKey, out var sel) ? sel : null;

    private async Task OnOptionSelected(string itemKey, string? option)
    {
        if (IsReadOnly) return;

        var data = GetOrCreateResponseData();
        data.Selections[itemKey] = option;
        Response.LastModified = DateTime.Now;

        if (OnResponseChanged.HasDelegate)
            await OnResponseChanged.InvokeAsync(Response);
    }

    private string GetLocalizedLabel(string english, string german, string fallback)
    {
        if (CurrentLanguage == Language.German && !string.IsNullOrWhiteSpace(german)) return german;
        if (!string.IsNullOrWhiteSpace(english)) return english;
        return fallback;
    }

    private RenderFragment RenderItems() => __builder =>
    {
        if (!items.Any())
        {
            <RadzenAlert AlertStyle="AlertStyle.Warning" Variant="Variant.Flat" Class="mb-3">
                <RadzenText TextStyle="TextStyle.Body2">
                    <strong>Configuration Error:</strong> No items are defined for this question.
                </RadzenText>
            </RadzenAlert>
            return;
        }

        <div class="binary-items">
            @foreach (var item in items)
            {
                var itemKey = item.Key;
                var selectedOption = GetSelectedOption(itemKey);
                var optionALabel = GetLocalizedLabel(item.OptionALabelEnglish, item.OptionALabelGerman, "Yes");
                var optionBLabel = GetLocalizedLabel(item.OptionBLabelEnglish, item.OptionBLabelGerman, "No");
                var itemTitle = GetLocalizedLabel(item.TitleEnglish, item.TitleGerman, string.Empty);

                <div class="binary-item-block" @key="@itemKey">
                    @if (!string.IsNullOrWhiteSpace(itemTitle))
                    {
                        <div class="item-title">@itemTitle</div>
                    }

                    <div class="binary-options">
                        <RadzenRadioButtonList TValue="string"
                                              Value="@selectedOption"
                                              ValueChanged="@((string v) => OnOptionSelected(itemKey, v))"
                                              Disabled="@IsReadOnly"
                                              Orientation="Radzen.Orientation.Vertical"
                                              Class="binary-radio-list">
                            <Items>
                                <RadzenRadioButtonListItem Value="@("A")" Text="@optionALabel" />
                                <RadzenRadioButtonListItem Value="@("B")" Text="@optionBLabel" />
                            </Items>
                        </RadzenRadioButtonList>

                        @if (!IsReadOnly && !item.IsRequired && selectedOption != null)
                        {
                            <a class="clear-selection-link" @onclick="@(() => OnOptionSelected(itemKey, null))" href="javascript:void(0)">
                                <RadzenIcon Icon="close" Class="me-1" />Clear selection
                            </a>
                        }

                        @if (item.IsRequired && selectedOption == null && !IsReadOnly)
                        {
                            <div class="binary-validation-hint">
                                <RadzenIcon Icon="info" Class="me-1" />
                                <span>Please select an option</span>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    };
}

<style>
    .binary-question {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .binary-items {
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
    }

    .binary-item-block {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .item-title {
        font-weight: var(--font-weight-heading, 600);
        font-size: 0.9375rem;
        color: var(--rz-text-color);
    }

    .binary-options {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .binary-radio-list {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .clear-selection-link {
        display: inline-flex;
        align-items: center;
        font-size: 0.8125rem;
        color: var(--rz-text-muted);
        text-decoration: none;
        cursor: pointer;
        width: fit-content;
    }

    .clear-selection-link:hover {
        color: var(--rz-danger);
        text-decoration: underline;
    }

    .binary-validation-hint {
        display: flex;
        align-items: center;
        font-size: 0.8125rem;
        color: var(--rz-danger);
    }
</style>
