@using Radzen.Blazor
@using ti8m.BeachBreak.Client.Models
@using ti8m.BeachBreak.Client.Models.DTOs
@using ti8m.BeachBreak.Client.Components.Shared
@inherits CategoryOptimizedTranslatableComponent

@if (!HideHeader)
{
    <div class="binary-question">
        <header class="question-header">
            <h3 class="question-title">
                @Section.GetLocalizedTitleWithFallback(CurrentLanguage)
                <EditedDuringReviewBadge Response="@Response" />
            </h3>

            @{
                var questionDescription = Section.GetLocalizedDescriptionWithFallback(CurrentLanguage);
            }
            @if (!string.IsNullOrWhiteSpace(questionDescription))
            {
                <p class="question-description">@questionDescription</p>
            }
        </header>

        @RenderBinaryOptions()
    </div>
}
else
{
    @RenderBinaryOptions()
}

@code {
    [Parameter, EditorRequired] public QuestionSection Section { get; set; } = default!;
    [Parameter, EditorRequired] public QuestionResponse Response { get; set; } = default!;
    [Parameter] public EventCallback<QuestionResponse> OnResponseChanged { get; set; }
    [Parameter] public bool IsReadOnly { get; set; } = false;
    [Parameter] public bool HideHeader { get; set; } = false;

    protected override string[] GetRequiredTranslationCategories() =>
    [
        TranslationCategories.Questions,
        TranslationCategories.Labels,
        TranslationCategories.Messages
    ];

    private string optionALabel = "Yes";
    private string optionBLabel = "No";
    private bool isRequired = false;

    protected override async Task OnInitializedAsync()
    {
        LoadConfiguration();
        await base.OnInitializedAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (StateService.HasParameterChanged(nameof(Section), Section))
        {
            LoadConfiguration();
        }
        await base.OnParametersSetAsync();
    }

    private void LoadConfiguration()
    {
        if (Section.Configuration is BinaryConfiguration config)
        {
            optionALabel = GetLocalizedLabel(config.OptionALabelEnglish, config.OptionALabelGerman, "Yes");
            optionBLabel = GetLocalizedLabel(config.OptionBLabelEnglish, config.OptionBLabelGerman, "No");
            isRequired = config.IsRequired;
        }
        else
        {
            optionALabel = "Yes";
            optionBLabel = "No";
            isRequired = false;
        }
    }

    private string GetLocalizedLabel(string english, string german, string fallback)
    {
        if (CurrentLanguage == Language.German && !string.IsNullOrWhiteSpace(german)) return german;
        if (!string.IsNullOrWhiteSpace(english)) return english;
        return fallback;
    }

    protected override bool HasStateChanged()
    {
        var responseDataHash = Response.ResponseData?.GetHashCode() ?? 0;
        return StateService.HasParameterChanged(nameof(Response.ResponseData), responseDataHash);
    }

    private BinaryResponseDataDto GetOrCreateResponseData()
    {
        if (Response.ResponseData is not BinaryResponseDataDto data)
        {
            data = new BinaryResponseDataDto();
            Response.ResponseData = data;
        }
        return data;
    }

    private string? GetSelectedOption() => GetOrCreateResponseData().SelectedOption;

    private async Task OnOptionSelected(string? option)
    {
        if (IsReadOnly) return;

        var data = GetOrCreateResponseData();
        data.SelectedOption = option;
        Response.LastModified = DateTime.Now;

        if (OnResponseChanged.HasDelegate)
            await OnResponseChanged.InvokeAsync(Response);
    }

    private async Task ClearSelection() => await OnOptionSelected(null);

    private RenderFragment RenderBinaryOptions() => __builder =>
    {
        var selectedOption = GetSelectedOption();

        <div class="binary-options">
            <RadzenRadioButtonList TValue="string"
                                  Value="@selectedOption"
                                  ValueChanged="@((string v) => OnOptionSelected(v))"
                                  Disabled="@IsReadOnly"
                                  Orientation="Radzen.Orientation.Vertical"
                                  Class="binary-radio-list">
                <Items>
                    <RadzenRadioButtonListItem Value="@("A")" Text="@optionALabel" />
                    <RadzenRadioButtonListItem Value="@("B")" Text="@optionBLabel" />
                </Items>
            </RadzenRadioButtonList>

            @if (!IsReadOnly && !isRequired && selectedOption != null)
            {
                <a class="clear-selection-link" @onclick="ClearSelection" href="javascript:void(0)">
                    <RadzenIcon Icon="close" Class="me-1" />Clear selection
                </a>
            }

            @if (isRequired && selectedOption == null && !IsReadOnly)
            {
                <div class="binary-validation-hint">
                    <RadzenIcon Icon="info" Class="me-1" />
                    <span>Please select an option</span>
                </div>
            }
        </div>
    };
}

<style>
    .binary-question {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .binary-options {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .binary-radio-list {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .clear-selection-link {
        display: inline-flex;
        align-items: center;
        font-size: 0.8125rem;
        color: var(--rz-text-muted);
        text-decoration: none;
        cursor: pointer;
        width: fit-content;
    }

    .clear-selection-link:hover {
        color: var(--rz-danger);
        text-decoration: underline;
    }

    .binary-validation-hint {
        display: flex;
        align-items: center;
        font-size: 0.8125rem;
        color: var(--rz-danger);
    }
</style>
