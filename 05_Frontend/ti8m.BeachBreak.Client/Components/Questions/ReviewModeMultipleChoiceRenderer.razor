@using Radzen.Blazor
@using ti8m.BeachBreak.Client.Models
@using ti8m.BeachBreak.Client.Models.DTOs
@using ti8m.BeachBreak.Client.Components.Shared

@if (!questions.Any())
{
    <RadzenAlert AlertStyle="AlertStyle.Warning" Variant="Variant.Flat" Class="mb-3">
        <RadzenText TextStyle="TextStyle.Body2">
            <strong>Configuration Error:</strong> No questions defined for this section.
        </RadzenText>
    </RadzenAlert>
}
else
{
    @foreach (var question in questions)
    {
        var employeeSelections = GetSelections(EmployeeResponse, question.Key);
        var managerSelections = GetSelections(ManagerResponse, question.Key);
        var hasDifference = !new HashSet<string>(employeeSelections).SetEquals(managerSelections);
        var level = hasDifference ? DifferenceLevel.Significant : DifferenceLevel.Match;
        var lang = CurrentLanguage == Language.German ? "de" : "en";
        var qTitle = question.GetLocalizedTitleWithFallback(lang);
        var choices = question.Choices.OrderBy(c => c.Order).ToList();

        <div class="evaluation-comparison-card" @key="@question.Key">
            @if (!string.IsNullOrWhiteSpace(qTitle))
            {
                <div class="question-item-title mb-2">@qTitle</div>
            }
            @{
                var qDesc = question.GetLocalizedDescription(lang);
            }
            @if (!string.IsNullOrWhiteSpace(qDesc))
            {
                <div class="question-item-description mb-2">@qDesc</div>
            }

            <div class="side-by-side-view">
                <div class="answer-column employee">
                    <div class="answer-header">
                        <span class="answer-label">
                            <RadzenIcon Icon="person" Style="font-size: 1rem;" />
                            Employee's Answer
                        </span>
                    </div>
                    <div class="answer-content">
                        <div class="choice-list">
                            @foreach (var choice in choices)
                            {
                                var isSelected = employeeSelections.Contains(choice.Key);
                                var isOnlyManagerSide = !employeeSelections.Contains(choice.Key) && managerSelections.Contains(choice.Key);
                                var choiceLabel = choice.GetLocalizedLabelWithFallback(lang);
                                var choiceDesc = choice.GetLocalizedDescription(lang);
                                var hasDesc = !string.IsNullOrWhiteSpace(choiceDesc);
                                <div class="choice-item @(isSelected ? "choice-selected" : "") @(hasDifference && isOnlyManagerSide ? "choice-answer-differs" : "") choice-disabled @(hasDesc ? "choice-item-with-desc" : "")"
                                     @key="@choice.Key">
                                    <RadzenCheckBox TValue="bool" Value="@isSelected" Disabled="true" Name="@($"emp_{question.Key}_{choice.Key}")" />
                                    <div class="choice-content">
                                        <RadzenLabel Text="@choiceLabel" Component="@($"emp_{question.Key}_{choice.Key}")" Class="choice-label" />
                                        @if (hasDesc)
                                        {
                                            <div class="choice-description">@choiceDesc</div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <div class="difference-icon-column">
                    <DifferenceIndicatorIcon Level="@level" />
                </div>

                <div class="answer-column manager">
                    <div class="answer-header">
                        <span class="answer-label">
                            <RadzenIcon Icon="supervisor_account" Style="font-size: 1rem;" />
                            Manager's Answer
                        </span>
                    </div>
                    <div class="answer-content">
                        <div class="choice-list">
                            @foreach (var choice in choices)
                            {
                                var isSelected = managerSelections.Contains(choice.Key);
                                var isOnlyEmployeeSide = employeeSelections.Contains(choice.Key) && !managerSelections.Contains(choice.Key);
                                var choiceLabel = choice.GetLocalizedLabelWithFallback(lang);
                                var choiceDesc = choice.GetLocalizedDescription(lang);
                                var hasDesc = !string.IsNullOrWhiteSpace(choiceDesc);
                                <div class="choice-item @(isSelected ? "choice-selected" : "") @(hasDifference && isOnlyEmployeeSide ? "choice-answer-differs" : "") choice-disabled @(hasDesc ? "choice-item-with-desc" : "")"
                                     @key="@choice.Key">
                                    <RadzenCheckBox TValue="bool" Value="@isSelected" Disabled="true" Name="@($"mgr_{question.Key}_{choice.Key}")" />
                                    <div class="choice-content">
                                        <RadzenLabel Text="@choiceLabel" Component="@($"mgr_{question.Key}_{choice.Key}")" Class="choice-label" />
                                        @if (hasDesc)
                                        {
                                            <div class="choice-description">@choiceDesc</div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
}

@code {
    [Parameter, EditorRequired] public QuestionSection Question { get; set; } = default!;
    [Parameter, EditorRequired] public QuestionResponse EmployeeResponse { get; set; } = default!;
    [Parameter, EditorRequired] public QuestionResponse ManagerResponse { get; set; } = default!;
    [Parameter] public Language CurrentLanguage { get; set; } = Language.English;

    private List<MultipleChoiceQuestion> questions = new();

    protected override void OnParametersSet()
    {
        questions = Question.Configuration is MultipleChoiceConfiguration config
            ? config.Questions.OrderBy(q => q.Order).ToList()
            : new List<MultipleChoiceQuestion>();
    }

    private List<string> GetSelections(QuestionResponse response, string questionKey)
    {
        if (response.ResponseData is MultipleChoiceResponseDataDto data &&
            data.SelectionsByQuestion.TryGetValue(questionKey, out var sel))
            return sel;
        return new List<string>();
    }
}
